{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "gateway"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "gateway"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "gateway"
        }
      },
      "spec": {
        "serviceAccountName": "netplane",
        "terminationGracePeriodSeconds": 70,
        "containers": [
          {
            "name": "gateway",
            "image": "netplane-e2e:local",
            "imagePullPolicy": "Never",
            "command": [
              "/gateway"
            ],
            "env": [
              {
                "name": "POD_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.name"
                  }
                }
              },
              {
                "name": "POD_NAMESPACE",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.namespace"
                  }
                }
              }
            ],
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": 8080
              },
              "periodSeconds": 1
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
